.eslintcache
npm-debug.log*

# Python tooling scripts (scripts/libcheck)
__pycache__/
*.py[cod]
.venv/

# Wire captures: sessions are committed as golden transcripts, these are not
captures/LATEST
captures/*/_datadir/
captures/*/*.transcript.txt
captures/*/*.jsonl
captures/service.log

