{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BenchMesh",
  "mainBinaryName": "benchmesh",
  "version": "0.1.17",
  "identifier": "com.benchmesh.app",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Browser-based cockpit for lab instruments",
    "longDescription": "BenchMesh connects, controls, logs and automates serial and USBTMC lab instruments from one interface.",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../devices/": "devices/",
      "../../frontend/dist/": "ui/"
    }
  }
}
